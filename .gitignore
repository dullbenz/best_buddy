node_modules/
target/
dist/
.anchor/
app/src/idl/
app/node_modules/
app/dist/
.DS_Store
*.log

# Never commit keypairs. The program keypair in particular is the upgrade
# authority — losing it means no upgrades, leaking it means someone else can.
*keypair*.json
!snapshot/*.json

# Staging auth gate: the build is copied in at deploy time, and the .env holds
# the staging password. Neither belongs in git.
functions/node_modules/
functions/public/

# Game hub.
gamehub/node_modules/
gamehub/dist/
gamehub/test-results/
gamehub/playwright-report/
functions-gamehub/node_modules/
# Same trick as the claim site's gate: the build travels inside the function
# bundle, copied in at deploy time.
functions-gamehub/public/
# Generated by scripts/gamehub-sync.mjs. game-core/ and idl/ are the sources;
# committing the copies would let the two drift and be "fixed" in the wrong one.
functions-gamehub/core/
functions-gamehub/idl/

# Environment files anywhere in the tree. app/.env.local holds a live Helius
# key and functions/.env holds the staging password. Only the .example
# templates are tracked — they carry placeholders, never real values.
.env
.env.*
!.env.example
!*.env.example
.gstack/
