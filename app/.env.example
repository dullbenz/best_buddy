# Copy to app/.env.local for local development.
# In CI these come from GitHub repository variables, not this file.

# Archival/paid RPC. The public endpoint returns 403 to browsers, so the
# dashboard will not load against it.
VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# The deployed distributor program.
VITE_PROGRAM_ID=GBJbhGqP5HR3XfYEqnu7hboEk6PsXcT1y2WNAobQZY11
