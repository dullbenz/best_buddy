# Written at deploy time by .github/workflows/deploy-gamehub*.yml — never committed.
#
# GAMEHUB_SERVER_RPC_URL is NOT the browser's RPC endpoint. That key is locked to
# the site's origin and rejects server-side calls, so the backend needs its own
# unrestricted key. It is a secret; the browser one is not.
GAMEHUB_SERVER_RPC_URL=
GAMEHUB_PROGRAM_ID=
# Comma-separated wallets allowed to reach /api/admin/*.
# For the emulator, use the fixed test-admin wallet — its keypair derives from
# a public seed in test/helpers.js, so the suite can walk the real admin path.
# It must never appear in a deployed environment's allowlist:
# GAMEHUB_ADMIN_WALLETS=2MC7qzgi1txEvEFb5y1g1zUS7FWNSNTwgH3LYZLNdEwS
GAMEHUB_ADMIN_WALLETS=
# Staging only: guards the devnet-only /api/test/* routes.
GAMEHUB_TEST_KEY=
# Staging only: shared with the claim site's staging gate.
STAGING_USER=
STAGING_PASSWORD=
COMMIT_SHA=
