{
  "name": "buddy-distributor",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Four-bucket community distributor for the Buddy relaunch",
  "scripts": {
    "dev": "npm --prefix app run dev",
    "tunnel": "npm --prefix app run tunnel",
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "snapshot": "ts-node scripts/snapshot.ts",
    "verify-snapshot": "ts-node scripts/verify-snapshot.ts",
    "build-tree": "ts-node scripts/build-tree.ts",
    "init": "ts-node scripts/deploy-init.ts",
    "create-dev-stream": "ts-node scripts/create-dev-stream.ts",
    "team-withdraw": "ts-node scripts/team-withdraw.ts",
    "sign-claim": "ts-node scripts/sign-claim.ts",
    "gamehub:sync": "node scripts/gamehub-sync.mjs",
    "gamehub:dev": "npm --prefix gamehub run dev",
    "gamehub:build": "npm --prefix gamehub run build",
    "gamehub:test": "node --test \"game-core/test/**/*.test.js\"",
    "gamehub:payout": "ts-node scripts/gamehub-payout.ts",
    "emulators": "firebase emulators:start --only auth,functions,firestore --project demo-gamehub",
    "gamehub:e2e": "firebase emulators:exec --only auth,functions,firestore --project demo-gamehub \"npm --prefix gamehub run e2e:local\"",
    "gamehub:test:api": "firebase emulators:exec --only auth,functions,firestore --project demo-gamehub \"npm --prefix functions-gamehub test\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@sqds/multisig": "^2.1.4",
    "bs58": "^6.0.0",
    "js-sha3": "^0.13.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.9.0",
    "anchor-bankrun": "^0.5.0",
    "chai": "^4.5.0",
    "mocha": "^11.8.0",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "overrides": {
    "bigint-buffer": "^1.1.5",
    "serialize-javascript": "^7.0.5",
    "protobufjs": "^7.6.5",
    "ws": "^8.21.0",
    "lodash": "^4.18.0",
    "nanoid": "^3.3.18",
    "uuid": "^11.1.1"
  }
}
