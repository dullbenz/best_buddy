# Build-time configuration. CI supplies these from repository variables; none of
# them are secrets — the Firebase web values identify the project, they do not
# authorise anything, and access is decided by security rules and the API's own
# session checks.

# "mainnet-beta" in production, "devnet" on staging.
VITE_CLUSTER=

# The browser's RPC endpoint. Origin-locked at the provider, which is why the
# backend has its own separate key (GAMEHUB_SERVER_RPC_URL, a real secret).
VITE_RPC_URL=
# Used only when the page is served from localhost, which cannot be added to an
# origin allowlist.
VITE_LOCAL_RPC_URL=https://api.devnet.solana.com

VITE_PROGRAM_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
# Defaults to <project-id>.firebaseapp.com when unset.
VITE_FIREBASE_AUTH_DOMAIN=

# Bounces *.web.app / *.firebaseapp.com to the real hostname.
VITE_CANONICAL_HOST=

# MUST be unset in production. Compiles the end-to-end test wallet into the
# bundle; the production deploy greps dist/ and fails if its marker appears.
VITE_ENABLE_TEST_WALLET=
